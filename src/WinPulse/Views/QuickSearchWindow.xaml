<Window x:Class="WinPulse.Views.QuickSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinPulse quick search"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="580"
        Height="430"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">
    <Border Background="{DynamicResource BrushCard}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1"
            CornerRadius="14"
            Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="10" Opacity="0.55" Color="Black" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="16,14,16,8">
                <Grid>
                    <TextBlock Text="Quick search" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Ctrl+Shift+Space" Style="{StaticResource Caption}" HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>
                <TextBox x:Name="SearchBox"
                         Style="{StaticResource InputBox}"
                         FontSize="14"
                         Height="42"
                         Margin="0,10,0,0" />
            </StackPanel>

            <ListBox x:Name="ResultsList"
                     Grid.Row="1"
                     Background="Transparent"
                     BorderThickness="0"
                     MaxHeight="300"
                     Margin="6,0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="ResultsList_MouseDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,7" />
                        <Setter Property="Margin" Value="4,1" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushHover}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushAccentSoft}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Glyph}"
                                       FontFamily="{DynamicResource FontIcons}" FontSize="13"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource BrushAccent}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Grid.Row="1"
                       Text="Type a file name, page or action…"
                       Style="{StaticResource Muted}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="{Binding ElementName=ResultsList, Path=Items.Count, Converter={StaticResource EmptyToVis}}" />

            <Border Grid.Row="2" Padding="14,8" BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource BrushBorderSoft}">
                <TextBlock Text="↑↓ navigate    Enter run    Esc close"
                           Style="{StaticResource Caption}" />
            </Border>
        </Grid>
    </Border>
</Window>
