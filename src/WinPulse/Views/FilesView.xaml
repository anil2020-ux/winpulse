<UserControl x:Class="WinPulse.Views.FilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Focusable="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="14,12" Margin="0,0,10,10">
            <StackPanel>
                <WrapPanel>
                    <Grid Width="250" Margin="0,0,8,0">
                        <TextBox x:Name="SearchBox"
                                 Style="{StaticResource InputBox}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Search name, folder or extension"
                                   Margin="13,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <ComboBox Style="{StaticResource ComboTheme}" Width="146" Margin="0,0,8,0"
                              ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" />
                    <ComboBox Style="{StaticResource ComboTheme}" Width="136" Margin="0,0,8,0"
                              ItemsSource="{Binding DateFilters}" SelectedItem="{Binding SelectedDate}" />
                    <ComboBox Style="{StaticResource ComboTheme}" Width="146" Margin="0,0,8,0"
                              ItemsSource="{Binding SizeFilters}" SelectedItem="{Binding SelectedSize}" />
                    <ComboBox Style="{StaticResource ComboTheme}" Width="146" Margin="0,0,8,0"
                              ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}" />
                    <ComboBox Style="{StaticResource ComboTheme}" Width="150" Margin="0,0,8,0"
                              ItemsSource="{Binding RootOptions}" DisplayMemberPath="Display" SelectedItem="{Binding SelectedRoot}" />
                </WrapPanel>

                <Grid Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton Style="{StaticResource FilterChip}" Content="Screenshots"
                                      IsChecked="{Binding ScreenshotsOnly}" Margin="0,0,8,0" />
                        <ToggleButton Style="{StaticResource FilterChip}" Content="Installers"
                                      IsChecked="{Binding InstallersOnly}" Margin="0,0,8,0" />
                        <Button Content="Clear filters" Style="{StaticResource GhostButton}" FontSize="11"
                                Command="{Binding ClearFiltersCommand}" />
                        <TextBlock Text="{Binding SelectedCount, StringFormat={}{0} selected}"
                                   Style="{StaticResource Caption}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Scan now" Style="{StaticResource SmallButton}"
                                Command="{Binding ScanNowCommand}" Margin="0,0,8,0" />
                        <Button Content="Refresh" Style="{StaticResource SmallButton}"
                                Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
                        <Button Content="Preview" Style="{StaticResource SmallButton}"
                                Command="{Binding TogglePreviewCommand}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Grid + preview -->
        <Grid Grid.Row="1" Margin="0,0,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="6">
                <Grid>
                    <DataGrid x:Name="FilesGrid"
                              ItemsSource="{Binding Files}"
                              SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                              SelectionChanged="FilesGrid_SelectionChanged"
                              MouseDoubleClick="FilesGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="NAME" Width="2.1*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Glyph}"
                                                       FontFamily="{DynamicResource FontIcons}"
                                                       FontSize="14"
                                                       VerticalAlignment="Center"
                                                       Foreground="{Binding GlyphColorKey, Converter={StaticResource CategoryBrush}}" />
                                            <TextBlock Text="{Binding Name}"
                                                       Margin="10,0,0,0"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Name}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="TYPE" Width="92">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CategoryLabel}" Style="{StaticResource Muted}"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="SIZE" Width="82">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SizeText}" FontSize="12"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="MODIFIED" Width="104">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ModifiedRelative}" Style="{StaticResource Muted}"
                                                   VerticalAlignment="Center" ToolTip="{Binding ModifiedText}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="FOLDER" Width="1.4*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FolderName}" Style="{StaticResource Muted}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding FullPath}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="SOURCE" Width="96">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RootLabel}" Style="{StaticResource Muted}"
                                                   FontSize="11" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="" Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="&#xE72E;"
                                                   FontFamily="{DynamicResource FontIcons}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource BrushWarning}"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding Keep, Converter={StaticResource BoolToVis}}"
                                                   ToolTip="Protected from cleanup" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="No files match these filters. Try clearing the search or scan now."
                               Style="{StaticResource Muted}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="320"
                               Visibility="{Binding Files.Count, Converter={StaticResource EmptyToVis}}" />
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="10"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          Visibility="{Binding IsPreviewVisible, Converter={StaticResource BoolToVis}}" />

            <Border Grid.Column="2"
                    Width="392"
                    Style="{StaticResource CardBorder}"
                    Padding="0"
                    Visibility="{Binding IsPreviewVisible, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="16,14" BorderBrush="{DynamicResource BrushBorderSoft}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedFile.Name, TargetNullValue=No file selected}"
                                       FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding PreviewMeta}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                            <Border Style="{StaticResource PillBorder}" HorizontalAlignment="Left" Margin="0,8,0,0">
                                <TextBlock Text="{Binding PreviewTypeLabel, TargetNullValue=preview}" FontSize="10"
                                           Foreground="{DynamicResource BrushAccent}" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Padding="16,10" BorderBrush="{DynamicResource BrushBorderSoft}" BorderThickness="0,0,0,1"
                            Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Location" Style="{StaticResource Caption}" Margin="0,2,10,2" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedFile.Folder}" Style="{StaticResource Caption}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedFile.FullPath}" Margin="0,2" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Created" Style="{StaticResource Caption}" Margin="0,2,10,2" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedFile.CreatedText}" Style="{StaticResource Caption}" Margin="0,2" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Age" Style="{StaticResource Caption}" Margin="0,2,10,2" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedFile.AgeText}" Style="{StaticResource Caption}" Margin="0,2" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" Background="{DynamicResource BrushBgDeep}">
                        <TextBlock Text="Select a file to preview it here"
                                   Style="{StaticResource Muted}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding ShowEmptyPreview, Converter={StaticResource BoolToVis}}" />

                        <Border Visibility="{Binding ShowImagePreview, Converter={StaticResource BoolToVis}}" Padding="10">
                            <Image Source="{Binding PreviewImage}" Stretch="Uniform" />
                        </Border>

                        <TextBox Style="{StaticResource CodeBox}"
                                 Text="{Binding PreviewText, Mode=OneWay}"
                                 Visibility="{Binding ShowTextPreview, Converter={StaticResource BoolToVis}}" />

                        <wv2:WebView2 x:Name="PdfPreview"
                                      Source="{Binding PreviewPdfUri, Converter={StaticResource PdfUri}}"
                                      Visibility="{Binding ShowPdfPreview, Converter={StaticResource BoolToVis}}" />

                        <Grid Visibility="{Binding ShowMediaPreview, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <MediaElement x:Name="MediaPlayer"
                                          Grid.Row="0"
                                          Source="{Binding PreviewMedia}"
                                          LoadedBehavior="Manual"
                                          UnloadedBehavior="Manual"
                                          Stretch="Uniform"
                                          Margin="10" />
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
                                <Button Content="&#xE768;" FontFamily="{DynamicResource FontIcons}" Style="{StaticResource IconButton}"
                                        Click="PlayMedia_Click" Margin="0,0,6,0" ToolTip="Play" />
                                <Button Content="&#xE769;" FontFamily="{DynamicResource FontIcons}" Style="{StaticResource IconButton}"
                                        Click="PauseMedia_Click" Margin="0,0,6,0" ToolTip="Pause" />
                                <Button Content="&#xE71A;" FontFamily="{DynamicResource FontIcons}" Style="{StaticResource IconButton}"
                                        Click="StopMedia_Click" ToolTip="Stop" />
                            </StackPanel>
                        </Grid>

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="28"
                                    Visibility="{Binding ShowUnsupportedPreview, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="&#xE7C3;" FontFamily="{DynamicResource FontIcons}" FontSize="32"
                                       HorizontalAlignment="Center" Foreground="{DynamicResource BrushTextMuted}" />
                            <TextBlock Text="{Binding PreviewMessage}" Style="{StaticResource Muted}"
                                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,14,0,0" />
                            <Button Content="Open with default app" Style="{StaticResource SmallButton}"
                                    HorizontalAlignment="Center" Margin="0,16,0,0"
                                    Command="{Binding OpenCommand}" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="3" Padding="14,10" BorderBrush="{DynamicResource BrushBorderSoft}" BorderThickness="0,1,0,0">
                        <StackPanel>
                            <TextBlock Text="Showing the first 512 KB of this file."
                                       Style="{StaticResource Caption}"
                                       Visibility="{Binding PreviewTruncated, Converter={StaticResource BoolToVis}}" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Open" Style="{StaticResource SmallButton}" Margin="0,0,6,0"
                                        Command="{Binding OpenCommand}" />
                                <Button Content="Reveal" Style="{StaticResource SmallButton}" Margin="0,0,6,0"
                                        Command="{Binding RevealCommand}" />
                                <Button Content="Delete" Style="{StaticResource SmallButton}"
                                        Foreground="{DynamicResource BrushDanger}"
                                        Command="{Binding DeleteCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Action bar -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="14,10" Margin="0,0,10,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ResultSummary}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                    <TextBlock Text="  •  loading…" Style="{StaticResource Caption}" VerticalAlignment="Center"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <WrapPanel HorizontalAlignment="Right">
                    <Button Content="Open" Style="{StaticResource SmallButton}" Margin="0,0,6,0"
                            Command="{Binding OpenCommand}" />
                    <Button Content="Reveal" Style="{StaticResource SmallButton}" Margin="0,0,6,0"
                            Command="{Binding RevealCommand}" />
                    <Button Content="Rename" Style="{StaticResource SmallButton}" Margin="0,0,6,0"
                            Command="{Binding RenameCommand}" />
                    <Button Content="Copy to…" Style="{StaticResource SmallButton}" Margin="0,0,6,0"
                            Command="{Binding CopyCommand}" />
                    <Button Content="Move to…" Style="{StaticResource SmallButton}" Margin="0,0,6,0"
                            Command="{Binding MoveCommand}" />
                    <Button Content="Protect" Style="{StaticResource SmallButton}" Margin="0,0,6,0"
                            Command="{Binding ToggleProtectCommand}" />
                    <Button Content="Delete" Style="{StaticResource DangerButton}" Padding="12,6" FontSize="12"
                            Command="{Binding DeleteCommand}" />
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
