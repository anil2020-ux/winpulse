<UserControl x:Class="WinPulse.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="18,16" Margin="0,0,10,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,30,0">
                    <TextBlock Text="RECLAIMABLE SPACE" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding ReclaimableText}"
                               Style="{StaticResource StatValue}" FontSize="30" Margin="0,4,0,2" />
                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Muted}" TextWrapping="Wrap" MaxWidth="360" />
                </StackPanel>

                <UniformGrid Grid.Column="1" Columns="4" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Large files" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding LargeFilesText}" FontSize="12" FontWeight="SemiBold" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Stale downloads" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding OldDownloadsText}" FontSize="12" FontWeight="SemiBold" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Old screenshots" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding OldScreenshotsText}" FontSize="12" FontWeight="SemiBold" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Duplicates" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding DuplicatesText}" FontSize="12" FontWeight="SemiBold" Margin="0,3,0,0" />
                    </StackPanel>
                </UniformGrid>

                <Button Grid.Column="2" Content="Scan for cleanup" Style="{StaticResource PrimaryButton}"
                        VerticalAlignment="Center" Command="{Binding ScanNowCommand}" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="14,10" Margin="0,0,10,10">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Show" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ComboBox Style="{StaticResource ComboTheme}" Width="170"
                              ItemsSource="{Binding FilterOptions}"
                              SelectedItem="{Binding SelectedFilter}" />
                    <TextBlock Text="{Binding SelectedCount, StringFormat={}{0} selected}" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" Margin="14,0,0,0" />
                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" Margin="14,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="380" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Protect" Style="{StaticResource SmallButton}" Margin="0,0,8,0"
                            Command="{Binding ProtectSelectedCommand}" />
                    <Button Content="Move to Recycle Bin" Style="{StaticResource DangerButton}" Padding="14,7" FontSize="12"
                            Command="{Binding DeleteSelectedCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="6" Margin="0,0,10,0">
            <Grid>
                <DataGrid x:Name="CleanupGrid"
                          ItemsSource="{Binding ItemsView}"
                          SelectionChanged="CleanupGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="FILE" Width="2.1*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Glyph}" FontFamily="{DynamicResource FontIcons}"
                                                   FontSize="14" VerticalAlignment="Center"
                                                   Foreground="{Binding GlyphColorKey, Converter={StaticResource CategoryBrush}}" />
                                        <TextBlock Text="{Binding Name}" Margin="10,0,0,0" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="REASON" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource PillBorder}" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Reason}" FontSize="10"
                                                   Foreground="{Binding ReasonColorKey, Converter={StaticResource CategoryBrush}}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="SIZE" Width="86">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SizeText}" FontSize="12" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="MODIFIED" Width="104">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ModifiedText}" Style="{StaticResource Muted}" FontSize="11"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="FOLDER" Width="1.6*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Folder}" Style="{StaticResource Muted}" FontSize="11"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="Nothing to clean up yet. Run a cleanup scan to find large files, stale downloads, old screenshots and duplicate copies."
                           Style="{StaticResource Muted}"
                           TextWrapping="Wrap"
                           MaxWidth="420"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           Visibility="{Binding Items.Count, Converter={StaticResource EmptyToVis}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
