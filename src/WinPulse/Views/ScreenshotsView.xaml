<UserControl x:Class="WinPulse.Views.ScreenshotsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:WinPulse.Views">
    <UserControl.Resources>
        <Style x:Key="TileItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{DynamicResource BrushCardAlt}"
                                BorderBrush="{DynamicResource BrushBorder}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushCardHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSelection}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="16,12" Margin="0,0,10,10">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="SCREENSHOTS" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding CountText}" Style="{StaticResource StatValue}" FontSize="24" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                        <TextBlock Text="Tracked size" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding SizeText}" FontSize="13" FontWeight="SemiBold" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Older than 30 days" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding OldText}" FontSize="13" FontWeight="SemiBold" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ComboBox Style="{StaticResource ComboTheme}" Width="160" Margin="0,0,8,0"
                              ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" />
                    <Button Content="Preview" Style="{StaticResource SmallButton}" Margin="0,0,8,0"
                            Command="{Binding TogglePreviewCommand}" />
                    <Button Content="Delete older than 30 days" Style="{StaticResource DangerButton}"
                            Padding="12,7" FontSize="12" Margin="0,0,8,0"
                            Command="{Binding DeleteOldCommand}" />
                    <Button Content="Refresh" Style="{StaticResource SmallButton}"
                            Command="{Binding RefreshCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="8">
                <Grid>
                    <ListBox x:Name="ScreenshotList"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemsSource="{Binding Tiles}"
                             SelectedItem="{Binding SelectedTile, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource TileItemStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="ScreenshotList_MouseDoubleClick">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="180">
                                    <Border Height="108" Background="{DynamicResource BrushBgDeep}" CornerRadius="8">
                                        <Grid>
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                            <TextBlock Text="{Binding Glyph}"
                                                       FontFamily="{DynamicResource FontIcons}"
                                                       FontSize="28"
                                                       Foreground="{DynamicResource BrushTextMuted}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding Thumbnail, Converter={StaticResource NullToVis}}" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{Binding Name}" FontSize="11.5" Margin="2,7,2,0"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Tooltip}" />
                                    <TextBlock Text="{Binding Caption}" Style="{StaticResource Caption}" Margin="2,2,2,0"
                                               FontSize="10" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="No screenshots yet. Take a screenshot and WinPulse will pick it up on the next scan."
                               Style="{StaticResource Muted}"
                               TextWrapping="Wrap"
                               MaxWidth="360"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               Visibility="{Binding Tiles.Count, Converter={StaticResource EmptyToVis}}" />
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="10"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          Visibility="{Binding Preview.IsVisible, Converter={StaticResource BoolToVis}}" />

            <Border Grid.Column="2"
                    Width="392"
                    Style="{StaticResource CardBorder}"
                    Padding="0"
                    Visibility="{Binding Preview.IsVisible, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <views:PreviewPane Grid.Row="0" DataContext="{Binding Preview}" />

                    <Border Grid.Row="1" Padding="12,8"
                            BorderBrush="{DynamicResource BrushBorderSoft}" BorderThickness="0,1,0,0">
                        <WrapPanel>
                            <Button Content="Open" Style="{StaticResource SmallButton}" Margin="0,0,6,6"
                                    Command="{Binding OpenCommand}" />
                            <Button Content="Reveal" Style="{StaticResource SmallButton}" Margin="0,0,6,6"
                                    Command="{Binding RevealCommand}" />
                            <Button Content="Protect" Style="{StaticResource SmallButton}" Margin="0,0,6,6"
                                    Command="{Binding ProtectSelectedCommand}" />
                            <Button Content="Delete" Style="{StaticResource DangerButton}" Padding="12,6" FontSize="12"
                                    Margin="0,0,0,6" Command="{Binding DeleteSelectedCommand}" />
                        </WrapPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
