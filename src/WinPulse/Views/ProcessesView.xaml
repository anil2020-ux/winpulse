<UserControl x:Class="WinPulse.Views.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="14,12" Margin="0,0,10,10">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Grid Width="280" Margin="0,0,12,0">
                        <TextBox x:Name="ProcessSearchBox"
                                 Style="{StaticResource InputBox}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Filter by process, publisher or PID"
                                   Margin="13,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=ProcessSearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Refresh" Style="{StaticResource SmallButton}" Margin="0,0,8,0"
                            Command="{Binding RefreshCommand}" />
                    <Button Content="Open location" Style="{StaticResource SmallButton}" Margin="0,0,8,0"
                            Command="{Binding OpenLocationCommand}" />
                    <Button Content="End task" Style="{StaticResource DangerButton}" Padding="14,7" FontSize="12"
                            Command="{Binding EndTaskCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="6">
                <DataGrid ItemsSource="{Binding ProcessesView}"
                          SelectedItem="{Binding SelectedProcess, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="PROCESS" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="PID" Width="72">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Pid}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="CPU" Width="76">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CpuText}" HorizontalAlignment="Right" FontSize="12"
                                               Foreground="{DynamicResource BrushAccent}" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="MEMORY" Width="92">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding MemoryText}" HorizontalAlignment="Right" FontSize="12"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="PUBLISHER" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Company}" Style="{StaticResource Muted}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="STARTED" Width="116">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StartText}" Style="{StaticResource Muted}"
                                               FontSize="11" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Width="304" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="Process details" Style="{StaticResource CardTitle}" Margin="0,0,0,12" />

                    <StackPanel Visibility="{Binding SelectedProcess, Converter={StaticResource NullToVis}}">
                        <TextBlock Text="{Binding SelectedProcess.Name}" FontSize="16" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding SelectedProcess.Description}" Style="{StaticResource Caption}"
                                   Margin="0,3,0,0" TextWrapping="Wrap" />

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="82" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="CPU" Style="{StaticResource Caption}" Margin="0,6" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedProcess.CpuText}" Style="{StaticResource Muted}" Margin="0,5" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Memory" Style="{StaticResource Caption}" Margin="0,6" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedProcess.MemoryText}" Style="{StaticResource Muted}" Margin="0,5" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Publisher" Style="{StaticResource Caption}" Margin="0,6" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedProcess.Company}" Style="{StaticResource Muted}" Margin="0,5"
                                       TextWrapping="Wrap" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Started" Style="{StaticResource Caption}" Margin="0,6" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedProcess.StartText}" Style="{StaticResource Muted}" Margin="0,5" />
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Path" Style="{StaticResource Caption}" Margin="0,6" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedProcess.FilePath}" Style="{StaticResource Muted}"
                                       Margin="0,5" TextWrapping="Wrap" FontSize="11" />
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Window" Style="{StaticResource Caption}" Margin="0,6" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedProcess.WindowTitle}" Style="{StaticResource Muted}"
                                       Margin="0,5" TextWrapping="Wrap" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="End task" Style="{StaticResource DangerButton}" Padding="12,7" FontSize="12"
                                    Margin="0,0,8,0" Command="{Binding EndTaskCommand}" />
                            <Button Content="Reveal" Style="{StaticResource SmallButton}"
                                    Command="{Binding OpenLocationCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Select a process to see details"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedProcess}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
