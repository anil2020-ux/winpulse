<Window x:Class="WinPulse.Views.DuplicateReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Duplicate review"
        Width="1120" Height="740"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Border Background="{DynamicResource BrushCard}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1"
            CornerRadius="16"
            Margin="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="12" Opacity="0.55" Color="Black" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="24,20,18,0">
                <StackPanel>
                    <TextBlock Text="Duplicate review" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock x:Name="SubtitleText" Style="{StaticResource Muted}" Margin="0,4,0,0"
                               Text="Pick the copy to keep in each group, then recycle the rest." />
                </StackPanel>
                <Border x:Name="StatsPill" Style="{StaticResource PillBorder}" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Margin="0,0,40,0">
                    <TextBlock x:Name="StatsText" FontSize="11" Foreground="{DynamicResource BrushSuccess}" />
                </Border>
                <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Content="&#xE8BB;" Click="Close_Click" />
            </Grid>

            <Grid Grid.Row="1" Margin="24,16,24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="304" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource SoftCard}" Padding="8" Margin="0,0,16,0">
                    <Grid>
                        <ListBox x:Name="GroupsList"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 SelectionChanged="GroupsList_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Margin" Value="2,2" />
                                    <Setter Property="Padding" Value="10,9" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushHover}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushAccentSoft}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="{Binding SizeText}" FontWeight="SemiBold" FontSize="12.5" />
                                            <TextBlock Text="{Binding ReclaimableText, StringFormat=free {0}}"
                                                       HorizontalAlignment="Right" FontSize="10.5"
                                                       Foreground="{DynamicResource BrushSuccess}" />
                                        </Grid>
                                        <TextBlock Text="{Binding CountText}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding DirectoryText}" Style="{StaticResource Caption}"
                                                   FontSize="10" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding DirectoryText}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock x:Name="EmptyText"
                                   Text="No duplicate groups left."
                                   Style="{StaticResource Muted}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed" />
                    </Grid>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock x:Name="GroupTitle" Style="{StaticResource CardTitle}" Text="Select a group" />
                            <TextBlock x:Name="GroupHint" Style="{StaticResource Caption}" Margin="0,3,0,0"
                                       Text="Click any copy to choose the one WinPulse keeps." />
                        </StackPanel>
                        <Button Content="Recycle the other copies" Style="{StaticResource DangerButton}"
                                HorizontalAlignment="Right" Padding="14,7" FontSize="12"
                                Command="{x:Null}" Click="RecycleOthers_Click" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="CopiesItems">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="252" Margin="0,0,12,12" CornerRadius="12" BorderThickness="1"
                                            Padding="10" Cursor="Hand"
                                            MouseLeftButtonUp="CopyCard_Click" Tag="{Binding}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource BrushCardAlt}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Keep}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource BrushSelection}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <Border Height="138" Background="{DynamicResource BrushBgDeep}" CornerRadius="8">
                                                <Grid>
                                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                    <TextBlock Text="{Binding Glyph}"
                                                               FontFamily="{DynamicResource FontIcons}"
                                                               FontSize="30"
                                                               Foreground="{DynamicResource BrushTextMuted}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Visibility="{Binding Thumbnail, Converter={StaticResource NullToVis}}" />
                                                </Grid>
                                            </Border>
                                            <Grid Margin="1,8,1,0">
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                <Border Style="{StaticResource PillBorder}" HorizontalAlignment="Right"
                                                        Padding="6,1" Background="{DynamicResource BrushAccentSoft}">
                                                    <TextBlock Text="KEEP" FontSize="9" FontWeight="Bold"
                                                               Foreground="{DynamicResource BrushAccent}"
                                                               Visibility="{Binding Keep, Converter={StaticResource BoolToVis}}" />
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding Meta}" Style="{StaticResource Caption}" Margin="1,3,0,0" />
                                            <TextBlock Text="{Binding Folder}" Style="{StaticResource Caption}" FontSize="10"
                                                       Margin="1,1,0,0" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Folder}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BrushBorderSoft}"
                    Padding="24,14" Margin="0,12,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Click a copy to mark it as the keeper. Everything else in that group is recycled."
                                   Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Auto-resolve all (keep newest)" Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,0" Command="{x:Null}" Click="AutoResolve_Click" />
                        <Button Content="Close" Style="{StaticResource GhostButton}" Click="Close_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
