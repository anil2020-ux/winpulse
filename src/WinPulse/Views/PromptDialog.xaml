<Window x:Class="WinPulse.Views.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinPulse"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="Height"
        Width="470"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Border Background="{DynamicResource BrushCard}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1"
            CornerRadius="16"
            Margin="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.55" Color="Black" />
        </Border.Effect>
        <StackPanel Margin="24,22,24,22">
            <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" Text="WinPulse" TextWrapping="Wrap" />
            <TextBlock x:Name="MessageText"
                       Margin="0,10,0,0"
                       TextWrapping="Wrap"
                       FontSize="13"
                       Foreground="{DynamicResource BrushTextSecondary}" />
            <TextBox x:Name="ValueBox"
                     Style="{StaticResource InputBox}"
                     Margin="0,16,0,0"
                     Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button x:Name="CancelButton"
                        Content="Cancel"
                        Style="{StaticResource GhostButton}"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Click="Cancel_Click" />
                <Button x:Name="OkButton"
                        Content="Save"
                        Style="{StaticResource PrimaryButton}"
                        IsDefault="True"
                        MinWidth="96"
                        Click="Ok_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
