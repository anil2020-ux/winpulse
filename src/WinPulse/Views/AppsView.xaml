<UserControl x:Class="WinPulse.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="14,12" Margin="0,0,10,10">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Grid Width="280" Margin="0,0,12,0">
                        <TextBox x:Name="AppSearchBox"
                                 Style="{StaticResource InputBox}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Search installed apps or publishers"
                                   Margin="13,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=AppSearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Refresh" Style="{StaticResource SmallButton}" Margin="0,0,8,0"
                            Command="{Binding RefreshCommand}" />
                    <Button Content="Open folder" Style="{StaticResource SmallButton}" Margin="0,0,8,0"
                            Command="{Binding OpenInstallLocationCommand}" />
                    <Button Content="Uninstall" Style="{StaticResource DangerButton}" Padding="14,7" FontSize="12"
                            Command="{Binding UninstallCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.7*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="6" Margin="0,0,10,0">
                <DataGrid ItemsSource="{Binding AppsView}"
                          SelectedItem="{Binding SelectedApp, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="APPLICATION" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding PublisherText}" Style="{StaticResource Caption}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="VERSION" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding VersionText}" Style="{StaticResource Muted}" FontSize="11"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="SIZE" Width="86">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SizeText}" Style="{StaticResource Muted}" FontSize="11"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="INSTALLED" Width="104">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding InstallDateText}" Style="{StaticResource Muted}" FontSize="11"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Installers in your folders" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding InstallerSummary}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        <TextBlock Text="Setup files (.exe, .msi, .msix) found in tracked folders."
                                   Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Installers}"
                              SelectedItem="{Binding SelectedInstaller, Mode=TwoWay}"
                              RowHeight="40">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="FILE" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Glyph}" FontFamily="{DynamicResource FontIcons}"
                                                       FontSize="12" Foreground="{DynamicResource BrushAccent}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" Margin="8,0,0,0" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="SIZE" Width="72">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SizeText}" Style="{StaticResource Muted}" FontSize="11"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="SAVED" Width="82">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ModifiedRelative}" Style="{StaticResource Caption}"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Open" Style="{StaticResource SmallButton}" Margin="0,0,6,0"
                                Command="{Binding OpenInstallerCommand}" />
                        <Button Content="Reveal" Style="{StaticResource SmallButton}" Margin="0,0,6,0"
                                Command="{Binding RevealInstallerCommand}" />
                        <Button Content="Delete" Style="{StaticResource DangerButton}" Padding="12,6" FontSize="12"
                                Command="{Binding DeleteInstallerCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
