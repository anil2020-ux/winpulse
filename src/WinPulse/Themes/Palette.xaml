<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- WinPulse palette (dark). ThemeManager rewrites these brush colors for light mode. -->
    <SolidColorBrush x:Key="BrushBg" Color="#0A0E15" />
    <SolidColorBrush x:Key="BrushBgDeep" Color="#070A10" />
    <SolidColorBrush x:Key="BrushSidebar" Color="#0D121B" />
    <SolidColorBrush x:Key="BrushCard" Color="#121926" />
    <SolidColorBrush x:Key="BrushCardHover" Color="#17202F" />
    <SolidColorBrush x:Key="BrushCardAlt" Color="#0F1621" />
    <SolidColorBrush x:Key="BrushBorder" Color="#1D2839" />
    <SolidColorBrush x:Key="BrushBorderSoft" Color="#16202E" />
    <SolidColorBrush x:Key="BrushHover" Color="#1A2434" />
    <SolidColorBrush x:Key="BrushSelection" Color="#1B2B46" />
    <SolidColorBrush x:Key="BrushInput" Color="#0C121C" />
    <SolidColorBrush x:Key="BrushTextPrimary" Color="#EAF0FA" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="#9AA8BF" />
    <SolidColorBrush x:Key="BrushTextMuted" Color="#5F6E85" />
    <SolidColorBrush x:Key="BrushAccent" Color="#4C8DFF" />
    <SolidColorBrush x:Key="BrushAccentHover" Color="#6AA2FF" />
    <SolidColorBrush x:Key="BrushAccentSoft" Color="#15305A" />
    <SolidColorBrush x:Key="BrushSuccess" Color="#2DD4A7" />
    <SolidColorBrush x:Key="BrushSuccessSoft" Color="#0E3B31" />
    <SolidColorBrush x:Key="BrushWarning" Color="#F5B84C" />
    <SolidColorBrush x:Key="BrushWarningSoft" Color="#3D2F13" />
    <SolidColorBrush x:Key="BrushDanger" Color="#F2555A" />
    <SolidColorBrush x:Key="BrushDangerSoft" Color="#3E1A1F" />
    <SolidColorBrush x:Key="BrushPurple" Color="#A78BFA" />
    <SolidColorBrush x:Key="BrushCyan" Color="#38BDF8" />
    <SolidColorBrush x:Key="BrushPink" Color="#F472B6" />
    <SolidColorBrush x:Key="BrushOrange" Color="#FB923C" />

    <LinearGradientBrush x:Key="BrushHero" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1B3B6F" Offset="0" />
        <GradientStop Color="#13294B" Offset="0.55" />
        <GradientStop Color="#121926" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BrushAccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4C8DFF" Offset="0" />
        <GradientStop Color="#2DD4A7" Offset="1" />
    </LinearGradientBrush>

    <FontFamily x:Key="FontUi">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="FontDisplay">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="FontMono">Cascadia Mono, Consolas, Courier New</FontFamily>
    <FontFamily x:Key="FontIcons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
</ResourceDictionary>
